# No trailing slash: a sandboxed run symlinks `node_modules` into a worktree,
# and `node_modules/` alone does NOT match a symlink (only a directory), so the
# link got staged, committed and then checked out over the real tree.
node_modules
dist/
coverage/
*.log
*.db
*.db-wal
*.db-shm
.huginn/
.harness/
.env
.env.*
# npm is canonical here (package-lock.json is tracked); a pnpm install's lockfile
# and `npm pack` tarballs are local artifacts, not sources.
pnpm-lock.yaml
*.tgz
.pi/
